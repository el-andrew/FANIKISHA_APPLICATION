# Used by `npm run test:e2e`. Copy to .env.test. The database name must contain
# "test": the suite deletes every row in it.
NODE_ENV=test
DATABASE_URL="postgresql://fanikisha:fanikisha@localhost:5432/fanikisha_test?schema=public"
JWT_SECRET=test-secret-that-is-at-least-thirty-two-bytes-long
JWT_ISSUER=fanikisha-api
JWT_AUDIENCE=fanikisha-mobile
