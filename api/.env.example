# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000

# Matches docker-compose.yml
DATABASE_URL="postgresql://fanikisha:fanikisha@localhost:5432/fanikisha?schema=public"

# At least 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-bytes
JWT_ISSUER=fanikisha-api
JWT_AUDIENCE=fanikisha-mobile

# SMS (phone verification codes).
# "log" prints messages to the server log instead of sending them; it is
# refused in production. "beem" sends through Beem (https://beem.africa).
SMS_PROVIDER=log
# Required when SMS_PROVIDER=beem. Never commit real values.
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# Registered and activated in the Beem dashboard (max 11 characters):
# BEEM_SENDER_ID=FANIKISHA
