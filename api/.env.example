# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
# Reverse proxies in front of the API (1 on Render); 0 when reached directly.
# Rate limits count requests per client address, read past this many proxies.
TRUST_PROXY_HOPS=0

# Matches docker-compose.yml
DATABASE_URL="postgresql://fanikisha:fanikisha@localhost:5432/fanikisha?schema=public"

# At least 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-at-least-32-bytes
JWT_ISSUER=fanikisha-api
JWT_AUDIENCE=fanikisha-mobile

# SMS (phone verification codes).
# "log" prints messages to the server log instead of sending them; it is
# refused in production. "beem" sends through Beem (https://beem.africa).
SMS_PROVIDER=log
# Required when SMS_PROVIDER=beem. Never commit real values.
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# Registered and activated in the Beem dashboard (max 11 characters):
# BEEM_SENDER_ID=FANIKISHA

# Who runs Fanikisha, as published in the privacy policy and terms
# (/privacy, /terms). Required in production; placeholders are shown otherwise.
OPERATOR_NAME="NORTH KINGS LIMITED"
OPERATOR_REGISTRATION="211059125"
OPERATOR_ADDRESS="Dar es Salaam, Tanzania"
# The address users write to about their data. Required in production.
# OPERATOR_EMAIL="privacy@yourdomain.co.tz"
